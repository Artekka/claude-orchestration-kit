#!/usr/bin/env bash
# Opt-in pre-push secret scan for contributors to this repo. Install it with
#   bash .github/hooks/install-pre-push.sh
# It runs gitleaks (with the repo's .gitleaks.toml) on the commits this push sends, then the leak guard
# test on the working tree. A finding stops the push. To push anyway (you checked it is a false positive):
#   git push --no-verify
# git feeds one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>
set -u
ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
ZERO="0000000000000000000000000000000000000000"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, so the secret scan cannot run." >&2
  echo "  Install it (https://github.com/gitleaks/gitleaks#installing), or push with --no-verify." >&2
  exit 1
fi

rc=0
while read -r _lref lsha _rref rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "$lsha" = "$ZERO" ] && continue                    # deleting a remote ref sends nothing
  if [ "$rsha" = "$ZERO" ]; then range="$lsha --not --remotes"   # a new branch: only commits no remote has
  else range="$rsha..$lsha"; fi
  # --log-opts is split by gitleaks into git log arguments; the range holds no spaces in a path
  if ! gitleaks git . --config .gitleaks.toml --log-opts="$range" --redact --no-banner >&2; then
    echo "pre-push: gitleaks found a possible secret in the commits above ($range)." >&2
    rc=1
  fi
done

if [ -f tests/leak-guard.test.sh ] && ! bash tests/leak-guard.test.sh >&2; then
  echo "pre-push: the leak guard failed on the working tree (see above)." >&2
  rc=1
fi
exit "$rc"
